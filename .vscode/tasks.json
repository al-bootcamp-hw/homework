{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Swift: Build and Run",
      "type": "shell",
      "command": "swiftc",
      "args": [
        "${file}",
        "-o",
        "${fileDirname}\\${fileBasenameNoExtension}.exe"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${fileDirname}"
      },
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "Swift: Run",
      "type": "shell",
      "command": "${fileDirname}\\${fileBasenameNoExtension}.exe",
      "dependsOn": "Swift: Build and Run",
      "problemMatcher": [],
      "options": {
        "cwd": "${fileDirname}"
      }
    }
  ]
}